APP_ENV=local
APP_URL=http://localhost:8080
APP_DEBUG=true
FORCE_HTTPS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vending_machine
DB_USER=root
DB_PASS=
DB_SSL=false
# Required for TiDB Cloud on Render. Leave blank for local XAMPP.
DB_SSL_CA=

# Required to create an administrator on a fresh database. Do not commit a real value.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Set true for one deployment only when rotating the existing admin password.
RESET_ADMIN_PASSWORD=false

# At least 32 random characters. Required and enforced when APP_ENV=production.
JWT_SECRET=local-dev-only-change-before-deploy-32chars-min
# Token lifetime in seconds (minimum 300). Default 1 hour.
JWT_TTL=3600

# Comma-separated browser origins allowed to call the JSON API. Empty = same-origin only (recommended).
CORS_ALLOWED_ORIGINS=

# Comma-separated proxy IPs/CIDRs trusted for X-Forwarded-* (leave empty unless behind a reverse proxy).
TRUSTED_PROXIES=
